{
  "name": "wallzone",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:desktop": "concurrently \"cross-env BROWSER=none next dev\" \"wait-on tcp:3000 && npx cross-env NODE_ENV=development electron electron/main.js\"",
    "build:desktop": "next build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.wallzone.app",
    "productName": "WallZone",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json",
      "assets/images/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/images/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "private": true
}
